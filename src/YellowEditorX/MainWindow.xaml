<Window x:Class="YellowEditorX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WXEditorX" Icon="app.ico" Width="1500" Height="900" WindowState="Maximized"
        Background="{StaticResource Bg}" UseLayoutRounding="True"
        AllowDrop="True" PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        TextOptions.TextFormattingMode="Display">
    <DockPanel x:Name="Root">
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="NewButton" Style="{StaticResource Tool}" Click="NewCard_Click" ToolTip="새 카드 (Ctrl+N)">＋ 새 카드</Button>
                    <Button x:Name="DuplicateButton" Style="{StaticResource Tool}" Click="Duplicate_Click" ToolTip="지금 카드를 다음 빈 코드로 복제 (Ctrl+D)">⧉ 복제</Button>
                    <Button x:Name="SaveButton" Style="{StaticResource Primary}" Click="Save_Click" ToolTip="저장 (Ctrl+S)" Margin="4,0,8,0">저장</Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource Tool}" Click="Delete_Click" ToolTip="목록에서 선택한 카드 삭제 (Delete)">삭제</Button>
                    <Button x:Name="UndoButton" Style="{StaticResource Tool}" Click="Undo_Click" ToolTip="마지막 저장·삭제·복사 되돌리기 (Ctrl+Z)">↶ 되돌리기</Button>
                    <Rectangle Width="1" Fill="{StaticResource Line}" Margin="8,4"/>
                    <Button x:Name="ScriptButton" Style="{StaticResource Tool}" Margin="0" Click="Script_Click" ToolTip="스크립트 열기 — 없으면 만듭니다 (Ctrl+L). 오른쪽 클릭이나 ▾로 열 프로그램을 바꿔요">스크립트
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ScriptMenu" Opened="ScriptMenu_Opened">
                                <MenuItem x:Name="ScriptEditorItem" IsEnabled="False"/>
                                <Separator/>
                                <MenuItem Header="열 프로그램 고르기..." Click="PickScriptEditor_Click"/>
                                <MenuItem x:Name="ResetScriptEditorItem" Header="Windows 기본 프로그램으로 열기" Click="ResetScriptEditor_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource Tool}" Click="ScriptMenuButton_Click" ToolTip="스크립트를 열 프로그램 바꾸기" Padding="4,5">▾</Button>
                    <Button Style="{StaticResource Tool}" Click="ImportImage_Click" ToolTip="카드 이미지 가져오기 (Ctrl+I)">이미지</Button>
                    <Button Style="{StaticResource Tool}" Click="OpenFolder_Click" ToolTip="이 DB가 있는 폴더 열기">폴더</Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="ZoomText" Style="{StaticResource Label}" ToolTip="Ctrl + 마우스 휠, Ctrl+= / Ctrl+- / Ctrl+0"/>
                    <Button Style="{StaticResource Tool}" Click="ZoomOut_Click">－</Button>
                    <Button Style="{StaticResource Tool}" Click="ZoomIn_Click">＋</Button>
                    <Button Style="{StaticResource Tool}" Click="Help_Click">단축키</Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="DbPathText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid x:Name="Main" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="470" MinWidth="260"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.25*" MinWidth="520"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition x:Name="StringsColumn" Width="0.8*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============ left: databases and cards ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Style="{StaticResource Small}" Click="NewDb_Click" ToolTip="새 팩 .db 만들기 (pics, script 폴더도 같이 만듭니다)">새 DB</Button>
                                <Button Style="{StaticResource Small}" Click="OpenDb_Click" ToolTip="팩 .db 파일 열기 (여러 개를 한 번에 고를 수 있어요)" Margin="4,0,0,0">열기</Button>
                            </StackPanel>
                            <TextBlock Text="카드 DB" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="DbList" MaxHeight="230" BorderThickness="0" SelectionChanged="DbList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding Path}" Background="Transparent">
                                        <DockPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="DB 닫기" Click="CloseDb_Click"/>
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" PreviewKeyDown="FilterBox_PreviewKeyDown"
                                     ToolTip="지금 DB의 카드를 코드·이름(한·일)·텍스트·종류·클래스·카드 번호·제작 정보로 찾아요. 띄어쓰기로 여러 단어, Esc로 지우기 (Ctrl+F)"/>
                            <TextBlock Text="🔍 카드 검색 — 이름·텍스트·코드·카드 번호 (Ctrl+F)" Foreground="#9CA3AF" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=FilterBox, Converter={StaticResource Vis}}"/>
                        </Grid>
                        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" Margin="2,6,0,0"/>
                        <ListView x:Name="CardList" BorderThickness="0" SelectionMode="Extended"
                                  SelectionChanged="CardList_SelectionChanged" KeyDown="CardList_KeyDown"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  GridViewColumnHeader.Click="CardList_HeaderClick">
                            <ListView.ContextMenu>
                                <ContextMenu x:Name="CardMenu" Opened="CardMenu_Opened">
                                    <MenuItem x:Name="CopyToMenu" Header="다른 DB로 복사"/>
                                    <MenuItem x:Name="MoveToMenu" Header="다른 DB로 이동"/>
                                    <Separator/>
                                    <MenuItem Header="삭제" Click="Delete_Click" InputGestureText="Delete"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="코드" Width="70" DisplayMemberBinding="{Binding Code}"/>
                                    <GridViewColumn Header="이름" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="종류" Width="80" DisplayMemberBinding="{Binding Kind}"/>
                                    <GridViewColumn Header="색" Width="40" DisplayMemberBinding="{Binding ColorText}"/>
                                    <GridViewColumn Header="Lv" Width="32" DisplayMemberBinding="{Binding LevelText}"/>
                                    <GridViewColumn Header="파워" Width="56" DisplayMemberBinding="{Binding PowerText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" DragCompleted="Splitter_DragCompleted"/>

            <!-- ============ center: the card ============ -->
            <Grid Grid.Column="2" x:Name="Editor">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- name (ko); the ja name of an official card under it -->
                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <Grid>
                                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="22" FontWeight="Bold" Padding="8,5"/>
                                <TextBlock Text="카드 이름 (한국어)" FontSize="22" Foreground="#B8BEC8" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text.IsEmpty, ElementName=NameBox, Converter={StaticResource Vis}}"/>
                            </Grid>
                            <TextBlock Text="{Binding JaName}" Foreground="{StaticResource Muted}" Margin="9,4,0,0" FontSize="14"
                                       Visibility="{Binding HasJa, Converter={StaticResource Vis}}" ToolTip="일본어 이름 (읽기 전용)"/>
                        </StackPanel>

                        <!-- image of the chosen print -->
                        <Border Grid.Row="1" x:Name="ImageBox" Width="216" Height="302" VerticalAlignment="Top" Margin="0,0,16,0"
                                CornerRadius="4" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#EEF0F4"
                                AllowDrop="True" Drop="Image_Drop" DragOver="Image_DragOver"
                                MouseLeftButtonDown="Image_MouseDown" MouseLeftButtonUp="Image_Click" Cursor="Hand"
                                ToolTip="고른 인쇄본의 이미지. 클릭해서 고르기, 파일을 끌어다 놓기, 우클릭으로 붙여넣기">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="파일에서 가져오기..." Click="ImportImage_Click" InputGestureText="Ctrl+I"/>
                                    <MenuItem Header="클립보드에서 붙여넣기" Click="PasteImage_Click"/>
                                    <MenuItem Header="pics 폴더 열기" Click="OpenPics_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <TextBlock x:Name="NoImageText" Text="이미지 없음&#x0a;&#x0a;클릭하거나&#x0a;파일을 끌어다 놓으세요" TextAlignment="Center"
                                           Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <Image x:Name="CardImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <!-- fields -->
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Label}"/>
                            </Grid.Resources>

                            <TextBlock Text="코드"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="CodeBox" Width="110" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" ToolTip="cid. 공식 카드는 1~999,999, 오리카 팩은 100만 단위 블록"/>
                                <Button Style="{StaticResource Small}" Margin="6,0,0,0" Click="NextCode_Click" ToolTip="안 쓰는 다음 코드 (Ctrl+Shift+N) — 목록에 있는 모든 DB를 확인합니다">다음 빈 코드</Button>
                                <TextBlock Text="동명 취급" Margin="18,0,8,0"/>
                                <TextBox Width="90" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="이름이 같아서 같은 카드로 취급할 대표 카드의 코드 (없으면 비워 두기). 일러만 다른 버전은 인쇄본으로 넣어요"/>
                                <TextBlock Text="{Binding SourceText}" Foreground="White" Background="#6B7280" Padding="7,2" Margin="14,0,0,0"/>
                                <TextBlock x:Name="NewBadge" Text="새 카드" Foreground="White" Background="#16A34A" Padding="7,2" Margin="8,0,0,0"
                                           Visibility="{Binding IsNew, Converter={StaticResource Vis}}"/>
                                <TextBlock Text="● 저장 안 됨" Foreground="{StaticResource Warn}" Margin="14,0,0,0"
                                           Visibility="{Binding IsDirty, Converter={StaticResource Vis}}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="종류" VerticalAlignment="Top" Margin="0,5,8,0"/>
                            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Kinds}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding Text}" IsChecked="{Binding IsChecked}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Row="2" Text="색" VerticalAlignment="Top" Margin="0,5,8,0"/>
                            <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Colors}" Margin="0,0,0,4"
                                          ToolTip="여러 색은 같이 켜요. 無는 무색(0), 아무것도 안 켜면 색 없음">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding Text}" IsChecked="{Binding IsChecked}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Row="3" Text="수치"/>
                            <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Visibility="{Binding ShowLevel, Converter={StaticResource Vis}}">
                                    <TextBlock Text="레벨"/>
                                    <TextBox Width="48" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Number_PreviewKeyDown" ToolTip="↑ / ↓ 키로 1씩. ∞는 ∞ 또는 -1"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Visibility="{Binding ShowLimit, Converter={StaticResource Vis}}">
                                    <TextBlock Text="리미트"/>
                                    <TextBox Width="48" Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Number_PreviewKeyDown" ToolTip="↑ / ↓ 키로 1씩. ∞는 ∞ 또는 -1"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Visibility="{Binding ShowPower, Converter={StaticResource Vis}}">
                                    <TextBlock Text="파워"/>
                                    <TextBox Width="70" Text="{Binding Power, UpdateSourceTrigger=PropertyChanged}" ToolTip="∞는 ∞ 또는 -1"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Visibility="{Binding ShowCoin, Converter={StaticResource Vis}}">
                                    <TextBlock Text="코인"/>
                                    <TextBox Width="40" Text="{Binding Coin, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Number_PreviewKeyDown" ToolTip="루리그가 오픈할 때 얻는 코인"/>
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Grid.Row="4" Text="비용" Visibility="{Binding ShowCostRow, Converter={StaticResource Vis}}"/>
                            <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Visibility="{Binding ShowCost, Converter={StaticResource Vis}}">
                                    <TextBlock Text="에나"/>
                                    <TextBox Width="120" FontFamily="Consolas" Text="{Binding CostEna, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{}{W}백 {R}적 {U}청 {G}녹 {B}흑 {C}무색, 혼성은 {W/B}. 예: {R}{C}{C}"/>
                                    <TextBlock Text="기타" Margin="10,0,8,0"/>
                                    <TextBox Width="110" FontFamily="Consolas" Text="{Binding CostOther, UpdateSourceTrigger=PropertyChanged}" ToolTip="JSON. 예: {&quot;coin&quot;: 1}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Visibility="{Binding ShowGrow, Converter={StaticResource Vis}}">
                                    <TextBlock Text="그로우"/>
                                    <TextBox Width="120" FontFamily="Consolas" Text="{Binding GrowEna, UpdateSourceTrigger=PropertyChanged}" ToolTip="{}{W}{R}{U}{G}{B}{C} 형식"/>
                                    <TextBlock Text="기타" Margin="10,0,8,0"/>
                                    <TextBox Width="110" FontFamily="Consolas" Text="{Binding GrowOther, UpdateSourceTrigger=PropertyChanged}" ToolTip="JSON. 예: {&quot;exceed&quot;: 1}"/>
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Grid.Row="5" Text="클래스" Visibility="{Binding ShowClass, Converter={StaticResource Vis}}"/>
                            <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Visibility="{Binding ShowClass, Converter={StaticResource Vis}}">
                                <ComboBox DockPanel.Dock="Right" Width="170" Margin="6,0,0,0" Tag="Classes" ItemsSource="{Binding Lists.Class}"
                                          IsEditable="True" DropDownClosed="ListPick_DropDownClosed" PreviewKeyDown="ListPick_PreviewKeyDown"
                                          ToolTip="골라서 추가 (직접 쓰고 Enter도 돼요)"/>
                                <TextBox Text="{Binding Classes, UpdateSourceTrigger=PropertyChanged}" ToolTip="시그니 클래스 / 루리그 타입. 여러 개는 쉼표로 구분"/>
                            </DockPanel>

                            <TextBlock Grid.Row="6" Text="한정 조건" Visibility="{Binding ShowLimitCond, Converter={StaticResource Vis}}"/>
                            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Visibility="{Binding ShowLimitCond, Converter={StaticResource Vis}}">
                                <ComboBox DockPanel.Dock="Right" Width="170" Margin="6,0,0,0" Tag="LimitCond" ItemsSource="{Binding Lists.LimitCond}"
                                          IsEditable="True" DropDownClosed="ListPick_DropDownClosed" PreviewKeyDown="ListPick_PreviewKeyDown"
                                          ToolTip="골라서 추가 (직접 쓰고 Enter도 돼요)"/>
                                <TextBox Text="{Binding LimitCond, UpdateSourceTrigger=PropertyChanged}" ToolTip="'限定'은 빼고 이름만. 여러 개는 쉼표로 구분"/>
                            </DockPanel>

                            <TextBlock Grid.Row="7" Text="팀" Visibility="{Binding ShowTeam, Converter={StaticResource Vis}}"/>
                            <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" Visibility="{Binding ShowTeam, Converter={StaticResource Vis}}">
                                <ComboBox DockPanel.Dock="Right" Width="170" Margin="6,0,0,0" Tag="Team" ItemsSource="{Binding Lists.Team}"
                                          IsEditable="True" DropDownClosed="ListPick_DropDownClosed" PreviewKeyDown="ListPick_PreviewKeyDown"
                                          ToolTip="골라서 추가 (직접 쓰고 Enter도 돼요)"/>
                                <TextBox Text="{Binding Team, UpdateSourceTrigger=PropertyChanged}" ToolTip="여러 개는 쉼표로 구분"/>
                            </DockPanel>

                            <TextBlock Grid.Row="8" Text="기타" VerticalAlignment="Top" Margin="0,5,8,0" Visibility="{Binding ShowOtherRow, Converter={StaticResource Vis}}"/>
                            <WrapPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Timings}" Margin="0,0,10,0" Visibility="{Binding ShowTiming, Converter={StaticResource Vis}}"
                                              ToolTip="사용 타이밍">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource Chip}" Content="{Binding Text}" IsChecked="{Binding IsChecked}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox Content="가드" IsChecked="{Binding Guard}" VerticalAlignment="Center" Margin="0,0,14,0"
                                          Visibility="{Binding ShowGuard, Converter={StaticResource Vis}}"/>
                                <CheckBox Content="라이프 버스트" IsChecked="{Binding LifeBurst}" VerticalAlignment="Center"
                                          Visibility="{Binding ShowLifeBurst, Converter={StaticResource Vis}}"/>
                            </WrapPanel>

                            <TextBlock Grid.Row="9" Text="읽는 법"/>
                            <TextBox Grid.Row="9" Grid.Column="1" Margin="0,0,10,8" Text="{Binding Reading, UpdateSourceTrigger=PropertyChanged}" ToolTip="한국어 이름 읽는 법 (검색용, 비워 둬도 돼요)"/>

                            <!-- 제작 정보: the card_meta table -->
                            <TextBlock Grid.Row="10" Text="제작 정보" VerticalAlignment="Top" Margin="0,5,8,0"/>
                            <Grid x:Name="MetaFields" Grid.Row="10" Grid.Column="1" Margin="0,4,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="제작자"/>
                                <TextBox x:Name="MakerBox" Grid.Column="1" Margin="0,0,0,6" Text="{Binding Maker, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="새 카드에는 마지막으로 쓴 이름이 채워져요"/>
                                <TextBlock Grid.Column="2" Text="태그" Margin="14,0,8,0"/>
                                <TextBox x:Name="TagsBox" Grid.Column="3" Margin="0,0,0,6" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Text="팩"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6" Text="{Binding Pack, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Text="제작일"/>
                                <TextBox x:Name="CreatedBox" Grid.Row="2" Grid.Column="1" Text="{Binding Created, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="yyyy-mm-dd. 새 카드를 처음 저장하면 오늘 날짜가 들어가요" FontFamily="Consolas"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="수정일" Margin="14,0,8,0"/>
                                <TextBox x:Name="ModifiedBox" Grid.Row="2" Grid.Column="3" Text="{Binding Modified, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="yyyy-mm-dd. 고쳐서 저장할 때마다 오늘 날짜로 바뀌어요 (직접 고친 경우는 그대로)" FontFamily="Consolas"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </Border>

                <!-- card text (ko) -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock x:Name="DescCount" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="능력 텍스트" Style="{StaticResource Heading}"/>
                        </DockPanel>
                        <TextBox x:Name="DescBox" Grid.Row="1" Text="{Binding Ability, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="False"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MinHeight="80"
                                 FontSize="15" Padding="8,6" TextChanged="DescBox_TextChanged"/>
                        <TextBlock Grid.Row="2" Text="라이프 버스트 텍스트" Style="{StaticResource Heading}" Margin="0,10,0,6"
                                   Visibility="{Binding ShowLifeBurst, Converter={StaticResource Vis}}"/>
                        <TextBox Grid.Row="3" Text="{Binding LbText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" MinHeight="44" MaxHeight="120" VerticalScrollBarVisibility="Auto" FontSize="15" Padding="8,6"
                                 Visibility="{Binding ShowLifeBurst, Converter={StaticResource Vis}}"/>
                        <TextBlock Grid.Row="4" Text="플레이버" Style="{StaticResource Heading}" Margin="0,10,0,6"/>
                        <TextBox Grid.Row="5" Text="{Binding Flavor, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" MinHeight="44" MaxHeight="100" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="8,6"/>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent" DragCompleted="Splitter_DragCompleted"/>

            <!-- ============ right: prints and the ja text ============ -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Style="{StaticResource Small}" Click="AddPrint_Click" ToolTip="인쇄본(일러) 추가">추가</Button>
                                <Button Style="{StaticResource Small}" Click="RemovePrint_Click" Margin="4,0,0,0" ToolTip="고른 인쇄본 빼기 (이미지 파일은 그대로)">빼기</Button>
                                <Button Style="{StaticResource Small}" Click="PrintUp_Click" Margin="4,0,0,0" ToolTip="위로 (맨 위가 idx 1, 기본 일러)">▲</Button>
                                <Button Style="{StaticResource Small}" Click="PrintDown_Click" Margin="4,0,0,0" ToolTip="아래로">▼</Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center">
                                인쇄본 <Run Text="— 맨 위가 기본 일러" FontWeight="Normal" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <DataGrid x:Name="PrintGrid" ItemsSource="{Binding Prints}" SelectedItem="{Binding SelectedPrint}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}"
                                  BorderThickness="0" Background="Transparent" RowHeaderWidth="0" SelectionMode="Single" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="idx" Binding="{Binding Idx}" IsReadOnly="True" Width="34"/>
                                <DataGridTextColumn Header="카드 번호" Binding="{Binding CardNo, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTextColumn Header="세트" Binding="{Binding SetCode, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="레어도" Binding="{Binding Rarity, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                                <DataGridTextColumn Header="일러스트" Binding="{Binding Illustrator, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="포맷" Binding="{Binding Formats, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}">
                            일본어 원문 <Run Text="— 읽기 전용" FontWeight="Normal" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Top" Text="일본어 텍스트가 없는 카드예요." Foreground="{StaticResource Muted}"
                                   Visibility="{Binding HasJa, Converter={StaticResource NotVis}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasJa, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="TextBox">
                                        <Setter Property="IsReadOnly" Value="True"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </StackPanel.Resources>
                                <TextBox Text="{Binding JaName, Mode=OneWay}" FontWeight="Bold" FontSize="16" Margin="0"/>
                                <TextBox Text="{Binding JaReading, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <TextBox Text="{Binding JaAbility, Mode=OneWay}"/>
                                <TextBlock Text="ライフバースト" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <TextBox Text="{Binding JaLbText, Mode=OneWay}"/>
                                <TextBox Text="{Binding JaFlavor, Mode=OneWay}" Foreground="{StaticResource Muted}" FontStyle="Italic"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
